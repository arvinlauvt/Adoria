# --- Site ---
# Full public URL of the deployed site, no trailing slash.
# Use your vercel.app URL until your custom domain is live, then switch it.
SITE_URL=https://adoria.vercel.app

# --- Airtable ---
# Create a token at https://airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write
# Access needed: the "Adoria Operations" base only
AIRTABLE_TOKEN=pat_xxxxxxxxxxxx
AIRTABLE_BASE_ID=appfj0RbV0rmJDaV2
AIRTABLE_TABLE_NAME=Orders

# --- ToyyibPay ---
# Find your Secret Key at the bottom of your ToyyibPay dashboard
TOYYIBPAY_SECRET_KEY=xxxxxxxxxxxx
# Create a Category in your ToyyibPay dashboard first, then paste its code here
TOYYIBPAY_CATEGORY_CODE=xxxxxxxxxxxx
# Use dev.toyyibpay.com while testing (sandbox), toyyibpay.com once you go live
TOYYIBPAY_BASE_URL=https://toyyibpay.com

# --- Auth: Airtable Users table ---
# Same base as Orders (AIRTABLE_BASE_ID above), separate table. See README
# "Auth (Users table)" for the exact schema to create.
AIRTABLE_USERS_TABLE_NAME=Users

# --- Auth: Upstash Redis ---
# Sessions, rate limiting, and short-lived reset/2FA tokens. Create a free
# database at https://upstash.com, then copy these from its dashboard.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# --- Auth: TOTP secret encryption ---
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key invalidates every enrolled user's 2FA — back it
# up somewhere safe, don't just leave it only in Netlify's env panel.
AUTH_ENCRYPTION_KEY=xxxxxxxxxxxx

# --- Auth: Resend (password reset emails) ---
# Sign up at https://resend.com, verify a sending domain (or use their
# shared test domain while developing), then create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Cubelle <no-reply@cubelle.my>
